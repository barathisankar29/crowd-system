# Copy this file to .env and fill in values for your machine.
# .env is gitignored — never commit real camera IPs or machine-specific paths.

# Which source /video_feed uses on startup: video | webcam | phone
SOURCE_TYPE=video

# Path to the bundled sample video, used when SOURCE_TYPE=video
VIDEO_FILE=cctv.mp4

# Webcam device index, used when SOURCE_TYPE=webcam
WEBCAM_INDEX=0

# Phone IP-Webcam stream URL (e.g. http://192.168.1.23:8080/video).
# Leave blank if you don't have a phone camera source — the "phone" entry
# in /sources simply won't be offered.
CAMERA_URL=

BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173

# SQLAlchemy connection string. SQLite by default; swap for a Postgres URL
# (postgresql+psycopg2://user:pass@host/db) with no code changes.
DB_URL=sqlite:///crowd_system.db

# Multiplier applied to the base per-zone capacity for non-"video" sources.
ZONE_SCALE=1.0
